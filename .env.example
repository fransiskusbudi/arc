# Postgres connection for the jobpilot database/role (see README for creation steps)
# Host is the taliu-postgres container's alias on the shared taliu_agent-network
DATABASE_URL=postgresql+psycopg://jobpilot:changeme@taliu-postgres:5432/jobpilot

# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET=changeme

# Seeded admin user, created on first backend boot if it doesn't already exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Open registration is disabled unless explicitly enabled
ALLOW_REGISTER=false

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Set the auth cookie's Secure flag (requires HTTPS) - enable in production
SECURE_COOKIES=false
